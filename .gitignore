# Syllabus build PDF
syllabus/syllabus.pdf

# Teaching build PDFs
teaching/*.pdf

# Word lock/temp files
~$*.docx

# Allow generated course slides (the *.pptx rule above excludes bulky decks in material/)
!slides/*.pptx
